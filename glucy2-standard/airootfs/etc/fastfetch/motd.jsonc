{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "source": "arch_small" },
  "modules": [
    "os",
    "host",
    "kernel",
    "display",
    { "type": "cpu", "temp": true },
    { "type": "gpu", "temp": true, "driverSpecific": true, "format": "{name} - VRAM {dedicated-used} / {dedicated-total} - {temperature}" },
    "memory",
    "disk",
    { "type": "physicaldisk", "temp": true },
    { "type": "localip", "showMac": true, "showSpeed": true, "showMtu": true },
    "battery"
  ]
}
